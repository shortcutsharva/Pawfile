# Optional build-time defaults. Copy to .env.local; .env and .env.* are gitignored.
#
# You do not need this file. Every variable below has a built-in default, and the
# recommended way to connect the backend is inside the app:
#   More -> Settings -> Data and sync -> Shared backend
# Values saved there take precedence over everything here.
#
# Do not put a real shared secret here for a build you distribute. EXPO_PUBLIC_*
# values are inlined into the JavaScript bundle and can be extracted from it.

# development | production
# "production" turns demo seeding off by default.
EXPO_PUBLIC_APP_ENV=development

# Apps Script deployment URL ending in /exec.
EXPO_PUBLIC_SHEETS_ENDPOINT=

# Must match APP_SHARED_SECRET in Apps Script Script Properties. 16+ characters.
EXPO_PUBLIC_SHEETS_SECRET=

# Seed demo records on first launch.
# Leave unset to use the default: true in development, false in production.
# Never enable this in a production build.
# EXPO_PUBLIC_DEMO_MODE=true

# Display name written into history entries. Defaults to "Activist".
EXPO_PUBLIC_DEFAULT_ACTOR_NAME=

# The spreadsheet ID is not read by the app. Set SPREADSHEET_ID in the Apps Script
# project's Script Properties instead.
