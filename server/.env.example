# Copy to server/.env for local development. Never commit the real file.

PORT=4000
HOST=0.0.0.0

# Shared with the app and the dashboard. Minimum 16 characters.
APP_SHARED_SECRET=replace-with-a-long-random-string

# Relative paths resolve against the server package directory.
DATABASE_PATH=./data/pawfile.db
UPLOADS_DIR=./data/uploads

# Built dashboard files. Defaults to ../dashboard/dist.
# DASHBOARD_DIR=../dashboard/dist

# Comma-separated allowed browser origins, or * for any.
CORS_ORIGINS=*

TZ=Asia/Kolkata
NODE_ENV=development
